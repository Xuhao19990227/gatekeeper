# 复制为 .env.local 后填写（.env* 已被 gitignore，绝不入库）
# LLM_FORMAT: anthropic | openai
# 不配置 = Mock 模式（/api/generate 返回占位产物，全链路仍可跑通）
LLM_BASE_URL=
LLM_AUTH_TOKEN=
LLM_MODEL=
LLM_FORMAT=anthropic
# 接口防护口令（公网部署强烈建议配置）：随机串，前端构建时内联并随请求头 x-gk-guard 携带，
# API 校验不符回 403。演示级防护（挡脚本直打，非真安全）；不配置=不校验。
NEXT_PUBLIC_GK_GUARD=
